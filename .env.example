# ============================================================
# Airsoft-Prim | Backend — шаблон переменных окружения
# ============================================================
# Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Секции соответствуют классам конфигурации в backend/core/config/:
#   APP_*      -> ApplicationConfiguration
#   DATABASE_* -> PostgresConfiguration
#   MINIO_*    -> MinioConfiguration
#
# Значения по умолчанию согласованы с docker-compose.yml
# (сервисы postgres и minio).

# ----------------------------- Приложение ------------------------------
# Название приложения.
APP_NAME=Airsoft-Prim | Backend

# Режим отладки (true/false). В production — false.
APP_DEBUG=false

# ------------------------------- База данных -----------------------------
# Хост БД: postgres при запуске через docker-compose,
# localhost при локальном запуске.
DATABASE_HOST=postgres

# Порт PostgreSQL.
DATABASE_PORT=5432

# Пользователь БД.
DATABASE_USER=airsoft

# Пароль пользователя БД.
DATABASE_PSWD=airsoft

# Имя базы данных.
DATABASE_NAME=airsoft_prim

# Драйвер SQLAlchemy (asyncpg и т. п.).
DATABASE_DRIVER=asyncpg

# ------------------------------- MinIO -----------------------------------
# Адрес S3-эндпоинта: minio:9000 при запуске через docker-compose,
# localhost:9000 при локальном запуске.
MINIO_ENDPOINT=minio:9000

# Access key MinIO.
MINIO_ACCESS_KEY=minioadmin

# Secret key MinIO.
MINIO_SECRET_KEY=minioadmin

# Использовать HTTPS (true/false).
MINIO_SECURE=false

# Регион S3 (можно оставить пустым).
MINIO_REGION=

# Проверять TLS-сертификат (true/false).
MINIO_CERT_CHECK=true
